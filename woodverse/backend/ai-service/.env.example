# WoodVerse AI Service Environment Variables
# Copy this file to .env for local development

# Required. Every /ai/* endpoint is rejected unless the caller sends this as x-api-key.
# There is no default: an unset or placeholder value makes the service return 503.
AI_SERVICE_API_KEY=replace-with-a-random-32-character-string

# Browser origins allowed to call this service directly (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4000

# Postgres, used to answer order status questions from the orders table.
# Must be the same database the Node API uses, otherwise the chatbot reads stale rows.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
DB_SSL=false
DB_POOL_SIZE=5

# How many recent orders a listing request returns
AI_ORDER_SUMMARY_LIMIT=5

# LLM used to classify the question and choose the right tool.
# Any OpenAI-compatible /v1/chat/completions endpoint works (OpenAI, OpenRouter,
# Groq, Together, Ollama, LocalAI, or an internal gateway).
# When AI_LLM_API_KEY is empty the service falls back to the bundled
# scikit-learn intent model, which is weaker on unseen wording.
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_MODEL=gpt-4o-mini
AI_LLM_TIMEOUT_SECONDS=8
AI_LLM_MAX_TOKENS=200
